# Force LF on checkout for all text files so SHA-256 checksums of the released
# metric artifacts are byte-identical on every OS (incl. Windows with autocrlf).
* text=auto eol=lf

# Binary assets: never apply EOL conversion.
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.parquet binary
*.npy  binary
*.npz  binary
*.zip  binary
